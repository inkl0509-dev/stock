rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in users can read or change stock.
    // Create user accounts yourself in Firebase console → Authentication → Users.

    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.min is number
        && request.resource.data.min >= 0;
      allow delete: if request.auth != null;
    }

    match /moves/{moveId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;   // activity log can't be edited
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
