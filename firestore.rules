rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed-in users (staff + admins) can read and update stock.
    // Users are created on the app's Admin page (or Firebase console → Authentication).
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }

    match /items/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.min is number
        && request.resource.data.min >= 0;
      allow delete: if signedIn();
    }

    match /moves/{moveId} {
      allow read, create: if signedIn();
      allow update, delete: if false;   // activity log can't be edited
    }

    // Units, categories, places, suppliers, outlets, breakage reasons — only admins can change
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
