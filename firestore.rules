rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── WHO CAN USE THE APP ─────────────────────────────────────────────
    // OWNER: this email is always an admin. Keep it the same as admins.js.
    function isOwner() {
      return request.auth != null && request.auth.token.email in ["iirufan@gmail.com"];
    }
    // Everyone else is added on the app's Admin → Users page (stored in settings/access).
    function accessPath() { return /databases/$(database)/documents/settings/access; }
    function listed(role) {
      return request.auth != null && exists(accessPath())
        && request.auth.token.email in get(accessPath()).data[role];
    }
    function isAdmin()  { return isOwner() || listed("admins"); }
    // Until the owner first opens the Admin page, any signed-in user can use the app.
    function isMember() {
      return isAdmin() || listed("staff") || (request.auth != null && !exists(accessPath()));
    }

    // ── MAIN STOCK + UNITS ──────────────────────────────────────────────
    // "main" = main stock (central store), u1 / u2 / u3 = the three units. Each has its own items.
    // Everyone on the list can SEE all of them.
    // OWNER and full admins: everything.  Per unit (set on Admin → Users → Manage):
    //   settings/access.siteAdmins = { main: [emails], u1: [...], ... }  unit admin: stock + packing units + fixes
    //   settings/access.managers   = { main: [emails], u1: [...], ... }  member: stock in / out, items
    function siteOf(d) { return d.get("site", "u1"); }       // stock entered before units existed belongs to Unit 1
    function validSite(s) { return s in ["main", "u1", "u2", "u3"]; }
    function inRole(key, s) {
      return request.auth != null && exists(accessPath()) && key in get(accessPath()).data
        && request.auth.token.email in get(accessPath()).data[key].get(s, []);
    }
    function siteAdmin(s) { return isAdmin() || inRole("siteAdmins", s); }
    function manages(s) {
      return siteAdmin(s)
        || (request.auth != null && !exists(accessPath()))
        || inRole("managers", s)
        || (exists(accessPath()) && !("managers" in get(accessPath()).data) && s == "u1" && listed("staff"));
    }

    // ── STOCK ───────────────────────────────────────────────────────────
    function validItem() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.min is number
        && request.resource.data.min >= 0;
    }
    // an item's units (single unit, main pack and how many it contains): only admins change them
    function unitsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["unit", "perCarton", "perPacket", "cartonName", "packName"]);
    }

    match /items/{itemId} {
      allow read: if isMember();
      allow create: if isMember() && validItem()
        && validSite(siteOf(request.resource.data)) && manages(siteOf(request.resource.data));
      allow update: if isMember() && validItem() && manages(siteOf(resource.data))
        && (isAdmin() || siteOf(request.resource.data) == siteOf(resource.data))
        && validSite(siteOf(request.resource.data))
        && (siteAdmin(siteOf(resource.data)) || unitsUnchanged());
      allow delete: if isMember() && manages(siteOf(resource.data));
    }

    match /moves/{moveId} {
      allow read: if isMember();
      allow create: if isMember() && manages(siteOf(request.resource.data));
      allow update, delete: if false;   // activity log can't be edited
    }

    // ── SETTINGS ────────────────────────────────────────────────────────
    // lists  = units, categories, places, suppliers, outlets, reasons
    // access = who is admin / member, which units each member may change, unit names
    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
